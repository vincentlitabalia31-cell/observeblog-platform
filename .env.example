# Database
MONGODB_URI=mongodb://127.0.0.1:27017/observing-india

# Auth (required)
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel cron digest auth (set in Production on Vercel)
CRON_SECRET=generate-a-long-random-secret

# Admin (matches Vercel ADMIN_EMAIL)
ADMIN_EMAIL=vincentlitabalia31@gmail.com

# Gmail SMTP — same names as Vercel Production (observe.noreply@gmail.com)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=observe.noreply@gmail.com
EMAIL_PASS=your-gmail-app-password-no-spaces
EMAIL_FROM="Observing India <observe.noreply@gmail.com>"

# Optional: Resend (only if you add RESEND_API_KEY on Vercel later)
# RESEND_API_KEY=
# NEWSLETTER_FROM="Observing India <observe.noreply@gmail.com>"
