# Database
MONGODB_URI=mongodb://127.0.0.1:27017/observing-india

# Auth (required)
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Public site URL (used in emails, sitemap, password reset links)
# On Vercel: https://your-domain.vercel.app or your custom domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email — choose ONE provider (Resend recommended for Vercel)

# Option A: Resend (recommended for production + local)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
NEWSLETTER_FROM="Observing India <newsletter@yourdomain.com>"

# Option B: SMTP (Gmail, SendGrid SMTP, etc.)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password
# EMAIL_FROM="Observing India <your-email@gmail.com>"
# EMAIL_SERVICE=gmail
